{
  "name": "grove",
  "version": "1.0.0",
  "description": "Lightweight library for tree data structures",
  "main": "grove.js",
  "module": "grove.esm.js",
  "types": "grove.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mladoniczky/grove.git"
  },
  "keywords": [
    "tree",
    "trie",
    "tree-structure",
    "search-tree",
    "binary-tree",
    "data-structure"
  ],
  "author": "Milan Mladoniczky",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mladoniczky/grove/issues"
  },
  "homepage": "https://github.com/mladoniczky/grove#readme",
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "package.json",
    "!**/*.spec.*",
    "!**/test"
  ],
  "scripts": {
    "test": "npm run test:spell && npm run test:lint && npm run test:unit",
    "test:spell": "cspell -s \"{*.md,src/**/*.ts}\"",
    "test:lint": "eslint src --ext .ts",
    "test:unit": "jest",
    "doc": "typedoc  --entryPoints src/lib/index.ts --exclude **/*.spec.* --out docs --theme default",
    "build": "tsc -p ./tsconfig.dts.json && rollup -c --bundleConfigAsCjs",
    "build:ts": "tsc -p ./tsconfig.json",
    "build:esm": "tsc -p ./tsconfig.esm.json",
    "build:dts":"tsc -p ./tsconfig.dts.json"
  },
  "dependencies": {
    "tslib": "~2.4.1"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "~0.3.0",
    "@rollup/plugin-typescript": "~11.0.0",
    "@typescript-eslint/eslint-plugin": "~5.48.0",
    "@typescript-eslint/parser": "~5.48.0",
    "cspell": "~6.18.1",
    "eslint": "~8.31.0",
    "eslint-plugin-eslint-comments": "~3.2.0",
    "eslint-plugin-import": "~2.26.0",
    "jest": "~29.3.1",
    "jest-sonar-reporter": "~2.0.0",
    "rollup": "~3.9.1",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-delete": "~2.0.0",
    "rollup-plugin-dts": "~5.1.1",
    "typedoc": "~0.23.24",
    "typescript": "~4.9.4"
  },
  "jest": {
    "verbose": true,
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "reporters": [
      "default"
    ],
    "testResultsProcessor": "jest-sonar-reporter"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "sonarqube-report.xml",
    "indent": 2
  }
}
